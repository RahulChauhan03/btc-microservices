# BTC Flow runtime variables. Copy to .env (git-ignored), fill in, and never commit .env.
# Config Server serves ${...} placeholders unresolved; each service resolves them from ITS OWN
# environment, so load this file into every service you start, not only Config Server.
#   Terminal:  set -a; source .env; set +a   (then start services from that shell)
#   IntelliJ:  add these to each run configuration's "Environment variables" (or an EnvFile plugin)
#   Docker:    docker run --env-file .env ...

# Required by user, trip, expense and claim services
MYSQL_USER=
MYSQL_PASSWORD=
# MYSQL_HOST=localhost
# MYSQL_PORT=3306

# Required by api-gateway, user, trip, expense and claim services. Same value everywhere,
# at least 32 bytes, e.g. generate with: openssl rand -base64 48
BTC_JWT_SECRET=
# BTC_JWT_ISSUER=btc-flow

# user-service, first start only: creates this admin if no account with the email exists (password >= 8 chars)
# BTC_ADMIN_EMAIL=
# BTC_ADMIN_PASSWORD=

# api-gateway, comma-separated
# BTC_CORS_ALLOWED_ORIGINS=http://localhost:4200

# All Config Server clients, if Config Server is not on localhost:8888
# CONFIG_SERVER_URL=http://localhost:8888

# user-service: password reset by email (forgot-password). Leave unset to keep the feature off (it answers 503).
# Use a test mailbox / sandbox SMTP service while developing; never commit real credentials.
# BTC_MAIL_HOST=smtp.example.com
# BTC_MAIL_PORT=587
# BTC_MAIL_USERNAME=
# BTC_MAIL_PASSWORD=
# BTC_MAIL_FROM=no-reply@example.com
# Set the next two to false only for a local test SMTP server without TLS / login
# BTC_MAIL_STARTTLS=true
# BTC_MAIL_SMTP_AUTH=true
# Origin of the Angular app used in reset links, e.g. http://localhost:4200 locally, https://... in production
# BTC_FRONTEND_BASE_URL=
# Reset-link lifetime, 5 minutes to 2 hours
# BTC_PASSWORD_RESET_TTL=PT15M
